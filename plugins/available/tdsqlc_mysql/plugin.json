{
  "id": "tdsqlc_mysql",
  "type": "inspection",
  "db_type": "tdsqlc_mysql",
  "name": "TDSQL-C MySQL",
  "version": "1.0.0",
  "description": "腾讯云 TDSQL-C MySQL 版（云原生 MySQL 兼容数据库），通过 PyMySQL 连接，完全复用 MySQL 巡检模板与规则引擎",
  "author": "DBCheck Team",
  "main_file": "main_plugin.py",
  "main_class": "TdsqlcMysqlInspector",
  "default_port": 3306,
  "default_user": "root",
  "compat_tag": "Relational",
  "emoji": "🐬",
  "default_database": "",
  "protocol": "mysql",
  "sql_editor": true,
  "show_database_field": true,
  "connect_test": "mysql",
  "baseline": {"reuse": "mysql"},
  "cleanup": {
    "db_types": ["tdsqlc_mysql"],
    "data_types": ["template", "baseline"]
  }
}
