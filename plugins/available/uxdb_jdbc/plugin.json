{
  "id": "uxdb_jdbc",
  "type": "inspection",
  "db_type": "uxdb",
  "name": "UXDB (优炫/JDBC)",
  "version": "1.0.0",
  "description": "适用于优炫数据库 UXDB（PostgreSQL 兼容系），通过 JDBC (JPype + uxdbjdbc) 连接，复用 PG 巡检模板",
  "author": "DBCheck Team",
  "main_file": "main_plugin.py",
  "main_class": "UxdbJdbcInspector",
  "dependencies": [
    "jpype1",
    "uxdbjdbc-2.1.2.3p.jre8.jar"
  ],
  "min_java_version": "1.8",
  "min_python_version": "3.6",
  "default_port": 33060,
  "default_user": "uxdb",
  "compat_tag": "Relational",
  "emoji": "🛡️",
  "cleanup": {
    "db_types": [
      "uxdb"
    ],
    "data_types": [
      "template",
      "baseline"
    ]
  },
  "default_database": "uxdb",
  "protocol": "pg",
  "sql_editor": true,
  "show_database_field": true,
  "baseline": {
    "reuse": "pg"
  }
}
