{
  "id": "hgdb_jdbc",
  "type": "inspection",
  "db_type": "hgdb",
  "name": "HGDB (瀚高/JDBC)",
  "version": "1.0.0",
  "description": "适用于瀚高数据库 HGDB V9（PostgreSQL 兼容系），通过 JDBC (JPype + PostgreSQL 驱动) 连接，复用 PG 巡检模板",
  "author": "DBCheck Team",
  "main_file": "main_plugin.py",
  "main_class": "HgdbJdbcInspector",
  "dependencies": ["jpype1", "postgresql-42.2.2.jar"],
  "min_java_version": "1.8",
  "min_python_version": "3.6",
  "default_port": 5866,
  "default_user": "highgo",
  "compat_tag": "Relational",
  "emoji": "🐘",
  "cleanup": {
    "db_types": ["hgdb"],
    "data_types": ["template", "baseline"]
  }
}
