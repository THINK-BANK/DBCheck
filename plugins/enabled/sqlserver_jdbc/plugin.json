{
  "id": "sqlserver_jdbc",
  "type": "inspection",
  "db_type": "sqlserver_jdbc",
  "name": "SQL Server (JDBC)",
  "version": "1.0.0",
  "description": "适用于 Microsoft SQL Server 2017/2019/2022/2025 实例，通过 JDBC (JPype + mssql-jdbc) 连接，数据驱动运行模式",
  "author": "DBCheck Team",
  "main_file": "main_plugin.py",
  "main_class": "MssqlJdbcInspector",
  "dependencies": [
    "jpype1",
    "mssql-jdbc-13.4.0.jre11.jar"
  ],
  "min_java_version": "1.8",
  "min_python_version": "3.6",
  "default_port": 1433,
  "default_user": "sa",
  "compat_tag": "Relational",
  "emoji": "🗄️",
  "cleanup": {
    "db_types": [
      "sqlserver_jdbc"
    ],
    "data_types": [
      "template",
      "baseline"
    ]
  },
  "default_database": "master",
  "protocol": "other",
  "sql_editor": false,
  "show_database_field": true,
  "connect_test": "sqlserver_jdbc",
  "baseline": null
}
