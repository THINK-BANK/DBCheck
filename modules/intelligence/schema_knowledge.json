            "表空间",
            "tablespace",
            "我的表空间"
          ],
          "fields": {
            "TABLESPACE_NAME": {
              "type": "VARCHAR2",
              "desc": "表空间名"
            },
            "BIGFILE": {
              "type": "VARCHAR2",
              "desc": "是否 BIGFILE"
            },
            "STATUS": {
              "type": "VARCHAR2",
              "desc": "状态"
            }
          }
        },
        "DBA_TABLES": {
          "description": "所有表信息",
          "keywords": [
            "表",
            "table",
            "表数量"
          ],
          "fields": {
            "OWNER": {
              "type": "VARCHAR2",
              "desc": "所属用户"
            },
            "TABLE_NAME": {
              "type": "VARCHAR2",
              "desc": "表名"
            },
            "TABLESPACE_NAME": {
              "type": "VARCHAR2",
              "desc": "表空间"
            },
            "NUM_ROWS": {
              "type": "NUMBER",
              "desc": "行数"
            },
            "BLOCKS": {
              "type": "NUMBER",
              "desc": "块数"
