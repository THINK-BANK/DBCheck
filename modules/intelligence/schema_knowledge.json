            "表空间",
            "tablespace",
            "bigfile",
            "表空间类型"
          ],
          "fields": {
            "TABLESPACE_NAME": {
              "type": "VARCHAR2",
              "desc": "表空间名"
            },
            "BIGFILE": {
              "type": "VARCHAR2",
              "desc": "是否 BIGFILE (YES/NO)"
            },
            "STATUS": {
              "type": "VARCHAR2",
              "desc": "状态"
            },
            "CONTENTS": {
              "type": "VARCHAR2",
              "desc": "类型"
            },
            "FILE_NAME": {
              "type": "VARCHAR2",
              "desc": "数据文件名"
            },
            "BLOCK_SIZE": {
              "type": "NUMBER",
              "desc": "块大小"
            },
            "MAX_SIZE": {
              "type": "NUMBER",
              "desc": "最大尺寸"
            }
          }
        },
        "USER_TABLESPACES": {
